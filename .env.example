# ==========================================
# Configurações do NatuNutri (Neon Database & Auth)
# ==========================================

# Endpoint de Autenticação do Neon
VITE_NEON_AUTH_URL=https://<seu-endpoint>.neonauth.<regiao>.aws.neon.tech/<database>/auth

# String de Conexão com o Banco PostgreSQL do Neon (Pooled connection)
VITE_DATABASE_URL=postgresql://<user>:<password>@<seu-pooler-host>.<regiao>.aws.neon.tech/<database>?sslmode=require
